msgstr "Konfiguracija pojavka"

msgid "Organization Name"
msgstr "Ime organizacije"

msgid "Set the organization name used on the SecureDrop web interfaces:"
msgstr "Nastavi ime organizacije, ki se uporablja v spletnih vmesnikih SecureDrop:"

msgid "Set Organization Name"
msgstr "Nastavi ime organizacije"

msgid "SET ORGANIZATION NAME"
msgstr "NASTAVI IME ORGANIZACIJE"

msgid "Logo Image"
msgstr "Logotip"

msgid ""
"Here you can update the image displayed on the SecureDrop web interfaces:"
msgstr "Tukaj lahko posodobite sliko, prikazano na spletnih vmesnikih SecureDrop:"

msgid "Logo image:"
msgstr "Logotip:"

msgid "Recommended size: 500px * 450px"
msgstr "Priporočena velikost: 500px * 450px"

msgid "Update Logo"
msgstr "Posodobi logotip"

msgid "UPDATE LOGO"
msgstr "POSODOBI LOGOTIP"

msgid "Submission Preferences"
msgstr "Preference oddaje"

msgid ""
"Prevent sources from uploading files. Sources will still be able to send "
"messages."
msgstr "Prepreči virom nalaganje datotek. Viri bodo še vedno lahko pošiljali sporočila."

msgid ""
"Prevent sources from sending initial messages shorter than the minimum "
"required length:"
msgstr "Prepreči virom pošiljanje začetnih sporočil, krajših od minimalne zahtevane dolžine:"

msgid "Minimum number of characters."
msgstr "Najmanjše število znakov."

