msgstr "Žal nam je, naš SecureDrop trenutno ni na voljo."

msgid "Please try again later. Check our website for more information."
msgstr "Poskusite znova pozneje. Za več informacij obiščite našo spletno stran."

msgid "LOG OUT"
msgstr "ODJAVI SE"

msgid "Server error"
msgstr "Napaka strežnika"

msgid ""
"Sorry, the website encountered an error and was unable to complete your "
