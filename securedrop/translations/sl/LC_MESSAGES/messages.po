msgid "Name too long"
msgstr "Ime je predolgo"

msgid "Must be at least {num} character long."
msgid_plural "Must be at least {num} characters long."
msgstr[0] "Mora biti vsaj {num} znak dolgo."
msgstr[1] "Mora biti vsaj {num} znaka dolgo."
msgstr[2] "Mora biti vsaj {num} znake dolgo."
msgstr[3] "Mora biti vsaj {num} znake dolgo."

msgid ""
"This username is invalid because it is reserved for internal use by the "
"software."
msgstr ""
"To uporabniško ime je neveljavno, ker je rezervirano za uporabo programske "
"opreme."

msgid "Invalid username"
msgstr "Neveljavno uporabniško ime"

msgid "{time} ago"
msgstr "Pred {time}"

msgid ""
"You have been logged out due to inactivity or a problem with your session."
msgstr "Bili ste odjavljeni zaradi neaktivnosti ali težave z vašo sejo."

msgid "SecureDrop"
msgstr "SecureDrop"

msgid "Incorrect password or two-factor code."
msgstr "Neveljavno geslo ali dvo-faktorska koda."

msgid "Your two-factor credentials have been reset successfully."
msgstr "Vaša dvo-faktorska poverilnica je bilo ponastavljena uspešno."

msgid "There was a problem verifying the two-factor code. Please try again."
msgstr "Bila je napaka pri potrditvi dvo-faktorske kode. Prosimo, poskusite kasneje."

msgid "Image updated."
msgstr "Slika posodobljena."

#. This error is shown when an uploaded image cannot be used.
msgid "Unable to process the image file. Please try another one."
msgstr ""
"Ni bilo mogoče prebrati slikovne datoteke. Prosimo, poskusite naslednjo."

msgid "Preferences saved."
msgstr "Preference shranjene."

msgid "Preferences not updated."
msgstr "Preference niso osvežene."

msgid "Failed to update organization name."
msgstr "Neuspešno posodabljanje imena organizacije."

msgid ""
"There was an error with the autogenerated password. User not created. Please "
"try again."
msgstr ""
"Bil je problem z avtomatsko genereranim geslom. Uporabnik ni narejen. "
"Prosimo, poskusite kasneje."

msgid ""
"Invalid HOTP secret format: please only submit letters A-F and numbers 0-9."
msgstr ""
"Neveljavna oblika skrivnega koda HOTP: prosimo, pošljajte samo črke A–F in "
"številke 0–9."

msgid "An unexpected error occurred! Please inform your admin."
msgstr "Nepričakovana napaka! Prosimo, informirajte svojega skrbnika."

#. Here, "{message}" explains the problem with the username.
msgid "Invalid username: {message}"
msgstr "Neveljavno uporabniško ime: {message}"

msgid "Username \"{username}\" already taken."
msgstr "Uporabniško ime \"{username}\" je že zasedeno."

msgid ""
"An error occurred saving this user to the database. Please inform your admin."
msgstr ""
"Pri shranjevanju tega uporabnika v zbirko podatkov je prišlo do napake. "
"Prosimo, obvestite svojega skrbnika."

msgid "The two-factor code for user \"{user}\" was verified successfully."
msgstr ""
"Dvofaktorska koda za uporabnika \"{user}\" je bila uspešno verificirana."

#. Here, "{message}" explains the problem with the name.
msgid "Name not updated: {message}"
msgstr "Ime ni posodobljeno: {message}"

msgid "Deleted user '{user}'."
msgstr "Izbrisan uporabnik '{user}'."

msgid "Test alert sent. Please check your email."
msgstr "Testno opozorilo poslano. Prosimo, preverite svojo e-pošto."

#. Precedes a message confirming the success of an operation.
msgid "Success!"
msgstr "Uspeh!"

msgid "The account and data for the source {} have been deleted."
msgstr "Račun in podatki za vir {} so bili izbrisani."

#. Error shown when a user has not selected items to act on.
msgid "Nothing Selected"
msgstr "Ničesar izbranega"

msgid "You must select one or more items."
msgstr "Izbrati morate enega ali več elementov."

msgid ""
"Your download failed because the file could not be found. An admin can find "
"more information in the system and monitoring logs."
msgid_plural ""
"Your download failed because a file could not be found. An admin can find "
"more information in the system and monitoring logs."
msgstr[0] ""
"Prenos ni uspel, ker datoteke ni bilo mogoče najti. Skrbnik lahko najde več "
"informacij v sistemskih in nadzornih dnevnikih."
msgstr[1] ""
"Prenos ni uspel, ker datotek ni bilo mogoče najti. Skrbnik lahko najde več "
"informacij v sistemskih in nadzornih dnevnikih."
msgstr[2] ""
"Prenos ni uspel, ker datotek ni bilo mogoče najti. Skrbnik lahko najde več "
"informacij v sistemskih in nadzornih dnevnikih."
msgstr[3] ""
"Prenos ni uspel, ker datotek ni bilo mogoče najti. Skrbnik lahko najde več "
"informacij v sistemskih in nadzornih dnevnikih."

msgid "Only admins can access this page."
msgstr "Do te strani lahko dostopajo samo skrbniki."

msgid "The \"{name}\" field is required when \"{other_name}\" is set."
msgstr "Polje \"{name}\" je obvezno, če je nastavljeno polje \"{other_name}\"."

msgid ""
"The \"{other_name}\" field was not found - it is required by \"{name}\"."
msgstr "Polja \"{other_name}\" ni bilo mogoče najti – zahteva ga \"{name}\"."

msgid "HOTP secrets are 40 characters long - you have entered {num}."
msgid_plural "HOTP secrets are 40 characters long - you have entered {num}."
msgstr[0] "Skrivnosti HOTP so dolge 40 znakov – vnesli ste {num}."
msgstr[1] "Skrivnosti HOTP so dolge 40 znakov – vnesli ste {num}."
msgstr[2] "Skrivnosti HOTP so dolge 40 znakov – vnesli ste {num}."
msgstr[3] "Skrivnosti HOTP so dolge 40 znakov – vnesli ste {num}."

msgid "Cannot be longer than {num} character."
msgid_plural "Cannot be longer than {num} characters."
msgstr[0] "Ne sme biti daljše od {num} znaka."
msgstr[1] "Ne sme biti daljše od {num} znakov."
msgstr[2] "Ne sme biti daljše od {num} znakov."
msgstr[3] "Ne sme biti daljše od {num} znakov."

msgid "Please specify an integer value greater than 0."
msgstr "Navedite celoštevilčno vrednost, večjo od 0."

msgid "This field is required."
msgstr "Polje je obvezno."

msgid "You cannot send an empty reply."
msgstr "Ne morete poslati praznega odgovora."

msgid ""
"To configure a minimum message length, you must set the required number of "
"characters."
msgstr ""
"Če želite konfigurirati minimalno dolžino sporočila, morate nastaviti "
"zahtevano število znakov."

msgid "File required."
msgstr "Zahtevana datoteka."

msgid "You can only upload PNG image files."
msgstr "Tja pošljete lahko samo slikovne datoteke PNG."

msgid "The source will receive your reply next time they log in."
msgstr "Vir bo prejel vaš odgovor, ko se bo naslednjič prijavil."

msgid "You must select one or more items for download"
msgstr "Za prenos sem morate izbrati enega ali več elementov"

msgid "You must select one or more items for deletion"
msgstr "Izbrati morate enega ali več elementov za brisanje"

msgid "No unread submissions for this source."
msgstr "Za ta vir ni neprebranih prispevkov."

msgid "You have been logged out due to inactivity."
msgstr "Bili ste odjavljeni zaradi neaktivnosti."

msgid "Account updated."
msgstr "Račun osvežen."

msgid "Login failed."
msgstr "Prijava ni uspela."

msgid "Please wait at least {num} second before logging in again."
msgid_plural "Please wait at least {num} seconds before logging in again."
msgstr[0] "Pred ponovno prijavo počakajte vsaj {num} sekundo."
msgstr[1] "Pred ponovno prijavo počakajte vsaj {num} sekundi."
msgstr[2] "Pred ponovno prijavo počakajte vsaj {num} sekunde."
msgstr[3] "Pred ponovno prijavo počakajte vsaj {num} sekund."

msgid ""
"Your 2FA details are invalid - please contact an administrator to reset them."
msgstr ""
"Vaši podatki za 2FA so neveljavni – obrnite se na skrbnika za ponastavitev."

msgid ""
"Please check your credentials. If you are using a two-factor mobile app or "
"security key, wait for a new code before trying again."
msgstr ""
"Preverite svoje poverilnice. Če uporabljate mobilno aplikacijo z dvema "
"korakoma varnostne zaščite ali varnostni ključ, počakajte na novo kodo, "
"preden poskusite znova."

msgid "The item has been deleted."
msgid_plural "{num} items have been deleted."
msgstr[0] "{num} element je bil izbrisan."
msgstr[1] "{num} elementa sta bila izbrisana."
msgstr[2] "{num} elementov je bilo izbrisanih."
msgstr[3] "{num} elementov je bilo izbrisanih."

msgid "No collections selected for deletion."
msgstr "Nobene zbirke ni izbrane za brisanje."

msgid "The account and all data for the source have been deleted."
msgid_plural "The accounts and all data for {n} sources have been deleted."
msgstr[0] "Računi in vsi podatki za {n} vir so bili izbrisani."
msgstr[1] "Računi in vsi podatki za {n} vira so bili izbrisani."
msgstr[2] "Računi in vsi podatki za {n} vire so bili izbrisani."
msgstr[3] "Računi in vsi podatki za {n} virov so bili izbrisani."

msgid "You must select one or more items for deletion."
msgstr "Izbrati morate enega ali več elementov za brisanje."

msgid "The files and messages have been deleted."
msgstr "Datoteke in sporočila so bila izbrisana."

msgid "Name updated."
msgstr "Ime posodobljeno."

msgid "The password you submitted is invalid. Password not changed."
msgstr "Geslo, ki ste ga vnesli, je neveljavno. Geslo ni bilo spremenjeno."

msgid ""
"There was an error, and the new password might not have been saved "
"correctly. To prevent you from getting locked out of your account, you "
"should reset your password again."
msgstr "Prišlo je do napake in novo geslo morda ni bilo pravilno shranjeno. Da preprečite, da bi izgubili dostop do računa, morate znova ponastaviti geslo."

msgid ""
"Password updated. Don't forget to save it in your KeePassX database. New "
"password:"
msgstr "Geslo posodobljeno. Ne pozabite ga shraniti v svojo bazo podatkov KeePassX. Novo geslo:"

msgid "No unread submissions in selected collections."
msgstr "Ni neprebranih prispevkov v izbranih zbirkah."

